raw `
Route102_MapScripts::
	.byte 0

Route102_EventScript_LittleBoy::
	msgbox Route102_Text_ImNotVeryTall, MSGBOX_NPC
	end

Route102_EventScript_RouteSignOldale::
	msgbox Route102_Text_RouteSignOldale, MSGBOX_SIGN
	end

Route102_EventScript_RouteSignPetalburg::
	msgbox Route102_Text_RouteSignPetalburg, MSGBOX_SIGN
	end

Route102_EventScript_Boy::
	msgbox Route102_Text_CatchWholeBunchOfPokemon, MSGBOX_NPC
	end

Route102_EventScript_Calvin::
	trainerbattle_single TRAINER_CALVIN_1, Route102_Text_CalvinIntro, Route102_Text_CalvinDefeated, Route102_EventScript_CalvinRegisterMatchCallAfterBattle
	specialvar VAR_RESULT, ShouldTryRematchBattle
	goto_if_eq VAR_RESULT, TRUE, Route102_EventScript_CalvinRematch
	setvar VAR_0x8004, TRAINER_CALVIN_1
	specialvar VAR_RESULT, IsTrainerRegistered
	goto_if_eq VAR_RESULT, FALSE, Route102_EventScript_CalvinTryRegister
	msgbox Route102_Text_CalvinPostBattle, MSGBOX_DEFAULT
	release
	end

Route102_EventScript_CalvinRegisterMatchCallAfterBattle::
	special PlayerFaceTrainerAfterBattle
	waitmovement 0
	goto_if_set FLAG_HAS_MATCH_CALL, Route102_EventScript_CalvinRegisterMatchCall
	release
	end

Route102_EventScript_CalvinRegisterMatchCall::
	msgbox Route102_Text_CalvinRegisterShort, MSGBOX_DEFAULT
	register_matchcall TRAINER_CALVIN_1
	release
	end

Route102_EventScript_CalvinTryRegister::
	goto_if_set FLAG_HAS_MATCH_CALL, Route102_EventScript_CalvinRegister
	msgbox Route102_Text_CalvinPostBattle, MSGBOX_DEFAULT
	release
	end

Route102_EventScript_CalvinRegister::
	msgbox Route102_Text_CalvinRegister, MSGBOX_DEFAULT
	register_matchcall TRAINER_CALVIN_1
	release
	end

Route102_EventScript_CalvinRematch::
	trainerbattle_rematch TRAINER_CALVIN_1, Route102_Text_CalvinRematchIntro, Route102_Text_CalvinRematchDefeated
	msgbox Route102_Text_CalvinRematchPostBattle, MSGBOX_AUTOCLOSE
	end

Route102_EventScript_Rick::
	trainerbattle_single TRAINER_RICK, Route102_Text_RickIntro, Route102_Text_RickDefeated
	msgbox Route102_Text_RickPostBattle, MSGBOX_AUTOCLOSE
	end

Route102_EventScript_Tiana::
	trainerbattle_single TRAINER_TIANA, Route102_Text_TianaIntro, Route102_Text_TianaDefeated
	msgbox Route102_Text_TianaPostBattle, MSGBOX_AUTOCLOSE
	end

Route102_EventScript_Allen::
	trainerbattle_single TRAINER_ALLEN, Route102_Text_AllenIntro, Route102_Text_AllenDefeated
	msgbox Route102_Text_AllenPostBattle, MSGBOX_AUTOCLOSE
	end

Route102_Text_WatchMeCatchPokemon:
	.string "WALLY: {PLAYER}…\n"
	.string "POKéMON hide in tall grass like this,\l"
	.string "don't they?\p"
	.string "Please watch me and see if I can\n"
	.string "catch one properly.\p"
	.string "…Whoa!$"

Route102_Text_WallyIDidIt:
	.string "WALLY: I did it… It's my…\n"
	.string "My POKéMON!$"

Route102_Text_LetsGoBack:
	.string "{PLAYER}, thank you!\n"
	.string "Let's go back to the GYM!$"

Route102_Text_ImNotVeryTall:
	.string "I'm…not very tall, so I sink right\n"
	.string "into tall grass.\p"
	.string "The grass goes up my nose and…\n"
	.string "Fwafwafwafwafwa…\p"
	.string "Fwatchoo!$"

Route102_Text_CatchWholeBunchOfPokemon:
	.string "I'm going to catch a whole bunch of\n"
	.string "POKéMON!$"

Route102_Text_RouteSignOldale:
	.string "ROUTE 102\n"
	.string "{RIGHT_ARROW} OLDALE TOWN$"

Route102_Text_RouteSignPetalburg:
	.string "ROUTE 102\n"
	.string "{LEFT_ARROW} PETALBURG CITY$"

`

const SKIP = 8
const PLAYER = OBJ_EVENT_ID_PLAYER
const CAMERA = OBJ_EVENT_ID_CAMERA

script RossanoFoothills_trg_RivalBattle {
	lockall
	applymovement(SKIP, Common_Movement_WalkInPlaceDown)
	waitmovement(0)
	delay(30)
	applymovement(SKIP, Common_Movement_ExclamationMark)
	waitmovement(0)
	playse(SE_PIN)
	waitse
	playbgm(MUS_RG_ENCOUNTER_RIVAL, FALSE)
	setspeaker("Skip")
	msgbox(format("Hey there's the slowpoke!"), MSGBOX_AUTOCLOSE)
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	if (var(VAR_TEMP_0) == 59) {
		applymovement(SKIP, RossanoFoothills_Movement_0)
		waitmovement(0)
		applymovement(PLAYER, Common_Movement_WalkInPlaceRight)
		waitmovement(0)
	} elif (var(VAR_TEMP_0) == 60) {
		applymovement(SKIP, RossanoFoothills_Movement_1)
		waitmovement(0)
	} elif (var(VAR_TEMP_0) == 61) {
		applymovement(SKIP, RossanoFoothills_Movement_2)
		waitmovement(0)
		applymovement(PLAYER, Common_Movement_WalkInPlaceLeft)
		waitmovement(0)
	} elif (var(VAR_TEMP_0) == 62) {
		applymovement(SKIP, RossanoFoothills_Movement_3)
		waitmovement(0)
		applymovement(PLAYER, Common_Movement_WalkInPlaceLeft)
		waitmovement(0)
	} elif (var(VAR_TEMP_0) == 63) {
		applymovement(SKIP, RossanoFoothills_Movement_4)
		waitmovement(0)
		applymovement(PLAYER, Common_Movement_WalkInPlaceLeft)
		waitmovement(0)
	}
	setspeaker("Skip")
	msgbox(format("Took ya long enough!\NDid the Professor give you an earful?\pKeepin' it real, I couldn't sit around for some lousy speech.\p“Take care of your Pokémon...”\NBlah blah blah\p{PLAYER}!\NMy dream has finally come true!\pToday marks the start of my journey to become the best Pokémon Trainer\Nin all of Ryoko.\pAnd you'll be my training buddy!\pWith your help, I can get stronger!\pSo let me wipe the floor with your face!"), MSGBOX_AUTOCLOSE)
	switch (var(VAR_STARTER_MON)) {
		case 0: // player chose rowlet
			trainerbattle_no_intro(TRAINER_RIVAL_SKIP_ROSSANO_2, RossanoFoothills_text_RivalDefeat)
		case 1: // player chose chimchar
			trainerbattle_no_intro(TRAINER_RIVAL_SKIP_ROSSANO_3, RossanoFoothills_text_RivalDefeat)
		case 2: // player chose froakie
			trainerbattle_no_intro(TRAINER_RIVAL_SKIP_ROSSANO_1, RossanoFoothills_text_RivalDefeat)
	}
	goto(RossanoFoothills_es_RivalDefeat)
	end
}

script RossanoFoothills_es_RivalDefeat {
	lockall
	playbgm(MUS_RG_RIVAL_EXIT, FALSE)
	setspeaker("Skip")
	msgbox(format("Tsk!{PAUSE 20}\NI need to train more.\pIt was a fine battle...\Nbut we're both just getting started.\pWhat?\NYou got somethin' for me?"), MSGBOX_AUTOCLOSE)
	delay(30)
	msgbox(format("You handed over the {COLOR GREEN}Parcel"), MSGBOX_AUTOCLOSE)
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	if (var(VAR_TEMP_0) == 59) {
		applymovement(SKIP, Common_Movement_WalkInPlaceLeft)
		waitmovement(0)
	} elif (var(VAR_TEMP_0) == 60) {
		applymovement(SKIP, Common_Movement_WalkInPlaceDown)
		waitmovement(0)
	} else {
		applymovement(SKIP, Common_Movement_WalkInPlaceRight)
		waitmovement(0)
	}
	removeitem(ITEM_PARCEL)
	delay(30)
	setspeaker("Skip")
	msgbox(format("So, Prof. Cypress wants us to complete the Pokédex too?\pI guess I can beat you in that too.\NHa!\pAlright, that'll be so easy.\pI stocked up on a bunch of Potions at the Pokécenter, I heard that there's a cave up ahead.\pApparently it's some sort of inactive lava chamber.\pWhatever, I'm not worried.\pThat'll just give my Pokémon some much needed training.\pSee ya later, slowpoke!"), MSGBOX_AUTOCLOSE)
	if (var(VAR_TEMP_0) == 60) {
		applymovement(SKIP, RossanoFoothills_Movement_5)
		waitmovement(0)
	} elif (var(VAR_TEMP_0) == 59) {
		applymovement(SKIP, RossanoFoothills_Movement_6)
		waitmovement(0)
	} else {
		applymovement(SKIP, RossanoFoothills_Movement_7)
		waitmovement(0)
	}
	fadenewbgm(MUS_RG_ROUTE11)
	setvar(VAR_ROSSANO_FOOTHILLS_RIVAL_BATTLE, 1)
	setflag(FLAG_ROSSANO_FOOTHILLS_RIVAL_BATTLE)
	removeobject(SKIP)
	releaseall
	end
}

text RossanoFoothills_text_RivalDefeat {
	format("What?\NI thought I picked the better Pokémon!")
}

movement RossanoFoothills_Movement_0 {
	walk_down * 3
	walk_in_place_left
}

movement RossanoFoothills_Movement_1 {
	walk_down * 2
}

movement RossanoFoothills_Movement_2 {
	walk_down * 3
	walk_in_place_right
}

movement RossanoFoothills_Movement_3 {
	walk_down * 3
	walk_right
}

movement RossanoFoothills_Movement_4 {
	walk_down * 3
	walk_right * 2
}

movement RossanoFoothills_Movement_5 {
	walk_up * 3
	walk_left * 8
}

movement RossanoFoothills_Movement_6 {
	walk_up * 4
	walk_left * 6
	walk_down * 2
	walk_left * 3
}

movement RossanoFoothills_Movement_7 {
	walk_up * 4
	walk_left * 8
}


script RossanoFoothills_Sign_IgnisCave {
    msgbox(format("{COLOR LIGHT_GREEN}- Ignis Cave -\n{FONT_SMALL}Inactive Lava Chambers Ahead"), MSGBOX_SIGN, MSGBOX_SUB_WOOD)
	end
}
script RossanoFoothills_Sign_RouteSign {
	msgbox(format("{COLOR LIGHT_GREEN}- Rossano Foothills -\p{COLOR DARK_GREY}{UP_ARROW} Treviso City\N{DOWN_ARROW} Ignis Cave"), MSGBOX_SIGN, MSGBOX_SUB_WOOD)
	end	
}

script RossanoFoothills_Object_Boy {
	msgbox(format("You can find all sorts of Pokémon between cities and towns.\p{COLOR GREEN}Ryoko{COLOR DARK_GREY} has a vast diversity between Pokémon in {COLOR GREEN}West Ryoko{COLOR DARK_GREY} and {COLOR GREEN}East Ryoko{COLOR DARK_GREY}."), MSGBOX_NPC)
	end
}
script RossanoFoothills_ItemBall_HyperPotion {
	finditem(ITEM_HYPER_POTION)
	end
}

script RossanoFoothills_Trainer_BirdKeeper {
	trainerbattle_single(TRAINER_BIRDKEEPER_CICERO, format("Caw!{PAUSE 16}\NCaw!\pFeathered friends, we have some prey!"), format("Caaaw!"))
	msgbox(format("Caw!{PAUSE 16}\NCaw!\pWhat do you think of my bird call?"), MSGBOX_NPC)
	end
}
script RossanoFoothills_Trainer_BugCatcher {
	trainerbattle_single(TRAINER_BUGCATCHER_GABRIEL, format("Have you found any rare bugs?"), format("Always more critters to find!"))
	msgbox(format("You can find critters all around Ryoko, in all sorts and sizes!"), MSGBOX_NPC)
	end
}
script RossanoFoothills_Trainer_Lass {
	trainerbattle_single(TRAINER_AROMALADY_JESSI, format("Hey!\NYou looked at me funny!"), format("Okay...\NI saw you first..."))
	msgbox(format("When a trainer sees you, be ready to battle!"), MSGBOX_NPC)
	end
}